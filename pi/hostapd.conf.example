interface=wlan0
driver=nl80211
ssid=csi-radar
country_code=IN
hw_mode=g
channel=1
ieee80211n=1
wmm_enabled=1
auth_algs=1
wpa=2
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
wpa_passphrase=CHANGE_ME
# OFDM-only: 11b (DSSS) frames carry no CSI, so never let rate control fall back to them
supported_rates=60 90 120 180 240 360 480 540
basic_rates=60 120 240
# drop a station that went silent (e.g. the ESP32 was reset) fast, or its rejoin is ignored until then
ap_max_inactivity=20
